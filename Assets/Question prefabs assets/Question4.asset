  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question4
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: 7. What is the role of adding pyridine during the acetylation of
    aniline using acetyl chloride?
  referenceImage: {fileID: 0}
  explanationText: 'The acetylation is carried out in the presence of a base stronger
    than the aniline, such as pyridine,

    which removes HCI so formed and shifts
    the equilibrium to the right-hand side. As a result, the

    formation of acetanilide
    increases.'
  options:
  - To dissolve the product formed
  - To shift the equilibrium in the forward direction
  - To reduce the yield of acetanilide
  - Pyridine does not react
  correctOptionIndex: 1
