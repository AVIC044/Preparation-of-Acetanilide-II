  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question2
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: 5. Which of the pair of the reagents cannot be used for acetylation
    of aniline?
  referenceImage: {fileID: 0}
  explanationText: 'The acetylation of aniline is usually carried out using acetic
    anhydride and glacial acetic acid. It can

    also be done using acetyl chloride
    with pyridine, or acetyl chloride with glacial acetic acid.

    However, acetylation
    of aniline cannot be done using the mixture of diethyl ether and ethanol.'
  options:
  - Acetyl chloride and galcial acetic acid.
  - Acetyl chloride and pyridine
  - Acetic anhydride and glacial acetic acid
  - Diethyl ether and ethanol
  correctOptionIndex: 3
